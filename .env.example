# ===== Native Go client/runtime =====
# Normally the CLI remembers the Cloud endpoint and paired device credential.
CODELOCAL_SERVER=https://codelocal.cloud
CODELOCAL_STATE_DIR=
CODELOCAL_ALLOW_SHELL=1
# Default when a workspace has no chat-selected local mode; deny/auto-safe remain restrictive machine-level overrides. Internal/legacy values: prompt | deny | auto-safe | agent | full; smart maps to agent.
CODELOCAL_APPROVAL_MODE=prompt
CODELOCAL_NETWORK=approval
CODELOCAL_WORKSPACE_IDLE_MS=1200000
CODELOCAL_TERMINAL_HISTORY_PATH=
CODELOCAL_AUDIT_PATH=
CODELOCAL_READ_CONCURRENCY=6

# Optional local MCP runtime limits.
CODELOCAL_MCP_SESSION_IDLE_MS=600000
CODELOCAL_MCP_MAX_TOOLS=5000
CODELOCAL_MCP_ALLOW_INSECURE_HTTP=0

# ===== Go Cloud gateway =====
HOST=0.0.0.0
PORT=3333
PUBLIC_BASE_URL=https://codelocal.cloud
MCP_AUTH_SECRET=replace-with-a-long-random-secret
# Dedicated KEK for user-owned AI provider credentials. Use a long random secret
# stored only in the deployment secret manager; database dumps contain wrapped
# provider keys, never plaintext API keys. Falls back to MCP_AUTH_SECRET only
# for backwards-compatible deployments.
CODELOCAL_PROVIDER_CREDENTIAL_KEK=
DATABASE_URL=postgres://user:password@host:5432/codelocal?sslmode=require
REDIS_URL=redis://default:password@host:6379/0
CODELOCAL_DB_POOL_SIZE=20
CODELOCAL_USAGE_LOCAL_QUEUE_SIZE=8192
CODELOCAL_USAGE_STREAM_MAXLEN=1000000
CODELOCAL_ENABLE_PPROF=0
# Durable Project Brain outbox. Health is aggregate-only and never reads payload/last_error content.
CODELOCAL_OUTBOX_POLL_MS=500
CODELOCAL_OUTBOX_LEASE_MS=30000
CODELOCAL_OUTBOX_RETRY_BASE_MS=500
CODELOCAL_OUTBOX_RETRY_MAX_MS=300000
CODELOCAL_OUTBOX_MAX_ATTEMPTS=12
CODELOCAL_OUTBOX_RETENTION_DAYS=14
CODELOCAL_OUTBOX_DEGRADED_AGE_MS=120000
CODELOCAL_OUTBOX_CRITICAL_AGE_MS=1800000
CODELOCAL_OUTBOX_CRITICAL_DEAD_COUNT=10
# Canonical Knowledge Graph is a derived/rebuildable Project Brain index. Oversized projects fail closed instead of publishing a partial graph.
CODELOCAL_KNOWLEDGE_GRAPH_MAX_REVISIONS_PER_PROJECT=2000
# Canonical embeddings are a derived/rebuildable index and remain OFF until an explicit semantic provider adapter is configured.
# They reuse CODELOCAL_EMBEDDING_PROVIDER/CODELOCAL_EMBEDDING_MODEL and the existing provider API key; no hashing/fake semantic fallback is used.
CODELOCAL_CANONICAL_EMBEDDINGS=0
# Required when canonical embeddings are enabled. Bump this when provider/model semantics change so re-embedding is deterministic.
CODELOCAL_CANONICAL_EMBEDDING_MODEL_VERSION=
CODELOCAL_CANONICAL_EMBEDDING_MAX_REVISIONS_PER_PROJECT=1000
CODELOCAL_CANONICAL_EMBEDDING_BATCH_SIZE=16
CODELOCAL_CANONICAL_EMBEDDING_MAINTENANCE_TIMEOUT=12s
# Separate cost/rollout gate: query embeddings are benchmarked asynchronously only in Knowledge V2 shadow mode.
CODELOCAL_CANONICAL_EMBEDDING_SHADOW=0
# Semantic readiness is a future live-ranking gate only; reaching READY does not enable semantic hits in model context by itself.
CODELOCAL_CANONICAL_SEMANTIC_READY_MIN_SAMPLES=50
CODELOCAL_CANONICAL_SEMANTIC_READY_MAX_ERROR_PERCENT=2
CODELOCAL_CANONICAL_SEMANTIC_READY_MAX_SLOW_PERCENT=10
CODELOCAL_CANONICAL_SEMANTIC_READY_MIN_HITS=20
CODELOCAL_CANONICAL_SEMANTIC_READY_MIN_HIGH_SIMILARITY_PERCENT=60
CODELOCAL_CANONICAL_SEMANTIC_READY_FRESH_DAYS=7
# Explicit live canary. Default OFF. Even when ON it requires base V2 readiness + current embedding index + semantic readiness=ready; failures fall back to deterministic hybrid.
CODELOCAL_CANONICAL_SEMANTIC_HYBRID=0
# Knowledge V2 read rollout: off|shadow|hybrid. Shadow stays the default and never changes legacy output.
# Hybrid is explicit canary-only: it requires per-project readiness=ready and may add at most two >=0.95-confidence canonical claims; any gate/read timeout falls back to legacy unchanged.
CODELOCAL_KNOWLEDGE_V2_READ_MODE=shadow
# Per-project shadow readiness gate. These metrics contain counts/latency only, never knowledge payload text.
CODELOCAL_KNOWLEDGE_V2_READY_MIN_SAMPLES=50
CODELOCAL_KNOWLEDGE_V2_READY_MAX_ERROR_PERCENT=2
CODELOCAL_KNOWLEDGE_V2_READY_MAX_SLOW_PERCENT=10
CODELOCAL_KNOWLEDGE_V2_READY_MIN_CANONICAL_HITS=10
CODELOCAL_KNOWLEDGE_V2_READY_MIN_HIGH_CONFIDENCE_PERCENT=80
CODELOCAL_KNOWLEDGE_V2_READY_FRESH_DAYS=7
CODELOCAL_KNOWLEDGE_V2_SHADOW_RETENTION_DAYS=30
# Portable learned-skill evidence older than this no longer contributes to cross-device corroboration.
# History/provenance is retained; stale/degraded Cloud suggestions are not imported by new clients.
CODELOCAL_PORTABLE_SKILL_EVIDENCE_MAX_AGE_DAYS=180
# Collective Intelligence is server-gated AND user opt-in. Both rollout flags are off by default.
# Contributions contain only structured/de-identified verified-outcome buckets, never raw code/conversation/project identity.
CODELOCAL_COLLECTIVE_CONTRIBUTION=0
CODELOCAL_COLLECTIVE_INTELLIGENCE=0
# Recommendations require at least this many independent users; implementation enforces a privacy floor of 5.
CODELOCAL_COLLECTIVE_MIN_CONTRIBUTORS=20
# Only recently refreshed per-user pattern aggregates participate in recommendation cohorts.
CODELOCAL_COLLECTIVE_FRESH_DAYS=90
# Comma-separated admin emails. If empty, defaults to monglv36@gmail.com.
CODELOCAL_ADMIN_EMAILS=

# ===== Dashboard chat model provider =====
# ShopAIKey is discovered server-side through GET /v1/models. Only chat-compatible
# models are exposed by the dashboard picker; the key is never sent to Next.js.
CODELOCAL_SHOPAIKEY_API_KEY=
CODELOCAL_SHOPAIKEY_BASE_URL=https://api.shopaikey.com/v1
CODELOCAL_SHOPAIKEY_MODEL=qwen3.5-flash

# Community lanes (free providers) never receive workspace-bound prompts,
# images, or obvious secrets unless the deployment explicitly opts in.
# CODELOCAL_ALLOW_COMMUNITY_WORKSPACE=1 permits workspace and image content
# on community lanes so a free model can do project work; obvious secrets
# stay blocked. Default off.
CODELOCAL_ALLOW_COMMUNITY_WORKSPACE=0
# Direct Zen lane for dashboard chat.
# OPENCODE_ZEN_API_KEY holds the Zen credential; the provider below points
# at https://opencode.ai/zen/v1 with muse-spark-1.3-contributor-free.
OPENCODE_ZEN_API_KEY=
# Generic OpenAI-compatible fallback. Prefer the provider-specific variables above.
CODELOCAL_LLM_PROVIDER=zen
CODELOCAL_LLM_API_KEY=
CODELOCAL_LLM_BASE_URL=https://opencode.ai/zen/v1
CODELOCAL_LLM_MODEL=muse-spark-1.3-contributor-free

# ===== Security scan =====
# Optional client-side executable overrides. By default CodeLocal can manage
# pinned Gitleaks/Trivy binaries under ~/.codelocal/security/tools.
# Semgrep remains externally managed in V1.
CODELOCAL_SECURITY_GITLEAKS_PATH=
CODELOCAL_SECURITY_TRIVY_PATH=
CODELOCAL_SECURITY_SEMGREP_PATH=
# Server-admin credential used only by POST /api/client/security/analyze.
# It is never returned to clients and never falls back to dashboard or user models.
CODELOCAL_SECURITY_LLM_API_KEY=
CODELOCAL_SECURITY_LLM_BASE_URL=https://api.openai.com/v1
CODELOCAL_SECURITY_LLM_MODEL=gpt-4o-mini

# ===== Skill Intelligence package storage =====
# Required for Personal imports, Community publishing, admin candidate ingestion
# and full promoted Skill artifacts. If bucket is empty, chat remains available
# with bounded built-in fallback knowledge and mutation UI is disabled.
# Works with AWS S3, Cloudflare R2, MinIO and other S3-compatible providers.
CODELOCAL_SKILL_STORAGE_BUCKET=
CODELOCAL_SKILL_STORAGE_PREFIX=codelocal-skills
CODELOCAL_SKILL_STORAGE_REGION=
CODELOCAL_SKILL_STORAGE_ENDPOINT=
CODELOCAL_SKILL_STORAGE_ACCESS_KEY_ID=
CODELOCAL_SKILL_STORAGE_SECRET_ACCESS_KEY=
# Set true for MinIO/providers requiring path-style bucket addressing.
CODELOCAL_SKILL_STORAGE_PATH_STYLE=false

# Optional client update notice advertised through MCP.
CODELOCAL_LATEST_CLIENT_VERSION=1.5.14
CODELOCAL_MIN_CLIENT_VERSION=1.5.5
CODELOCAL_RELEASE_CHANNEL=latest
# Defaults to: npm i -g codelocal@latest
CODELOCAL_UPDATE_COMMAND=
CODELOCAL_RESTART_COMMAND=codelocal
CODELOCAL_UPDATE_MESSAGE=CodeLocal has a new version available. Please tell the user to update.
# Local CLI startup update check. Disable with 0/false/off; registry defaults to npmjs.org.
CODELOCAL_UPDATE_CHECK=1
CODELOCAL_UPDATE_REGISTRY=

# Optional horizontal gateway instance override. Railway/HOSTNAME is used otherwise.
CODELOCAL_GATEWAY_INSTANCE_ID=

# ===== Design Engine (Penpot) =====
# Public Penpot surface embedded by Dashboard > Design.
CODELOCAL_DESIGN_URL=https://design.codelocal.cloud
# First-party confidential OIDC client used only by the Penpot backend. The
# client secret must be the same Railway secret referenced by
# PENPOT_OIDC_CLIENT_SECRET and must contain at least 24 characters.
CODELOCAL_PENPOT_OIDC_CLIENT_ID=codelocal-penpot
CODELOCAL_PENPOT_OIDC_CLIENT_SECRET=
CODELOCAL_PENPOT_OIDC_REDIRECT_URI=https://design.codelocal.cloud/api/auth/oidc/callback
# Hosted Penpot reuses CodeLocal Cloud data services: shared Postgres database `penpot` and shared Redis DB 1.
# Never provision a Penpot-specific Postgres/Redis/Valkey service.
# Penpot MCP is packaged with CodeLocal and normally needs no configuration. These are
# runtime-only escape hatches for development/debugging; never put a remote userToken here
# unless the deployment has per-user isolation.
CODELOCAL_PENPOT_MCP_URL=
CODELOCAL_PENPOT_MCP_CLI=

# ===== Next.js web presentation =====
# Leave empty for backend/API-only mode. Configure after the Next canary passes
# docs/operations/NEXT_WEB_CUTOVER.md.
# Railway private origin of the Next web service, for example:
# http://${{CodeLocal Web.RAILWAY_PRIVATE_DOMAIN}}:${{CodeLocal Web.PORT}}
CODELOCAL_WEB_ORIGIN=
# Optional temporary secret for the disabled-by-default edge canary probe.
# Remove after verification when not actively testing a web cutover.
CODELOCAL_EDGE_PROBE_TOKEN=

# ===== OpenAI Plugins Directory submission / public trust pages =====
# Set the exact token shown by the OpenAI submission portal. The gateway exposes it verbatim at
# /.well-known/openai-apps-challenge and returns 404 while this variable is empty.
OPENAI_APPS_CHALLENGE_TOKEN=
CODELOCAL_PUBLISHER_NAME=CodeLocal
CODELOCAL_SUPPORT_EMAIL=support@codelocal.cloud
CODELOCAL_SECURITY_EMAIL=security@codelocal.cloud

# ===== Reviewer sandbox runtime =====
# These secrets belong only in the reviewer runtime deployment, never in source control.
CODELOCAL_REVIEWER_SERVER_URL=https://codelocal.cloud
CODELOCAL_REVIEWER_CREDENTIAL_ID=
CODELOCAL_REVIEWER_CREDENTIAL_SECRET=
CODELOCAL_REVIEWER_DEVICE_ID=codelocal-openai-reviewer
CODELOCAL_REVIEWER_DEVICE_NAME=CodeLocal OpenAI Reviewer Sandbox
CODELOCAL_REVIEWER_WORKSPACE_NAME=codelocal-reviewer-project
